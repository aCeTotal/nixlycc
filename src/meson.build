qt6 = import('qt6')
qt6_dep = dependency('qt6', modules: ['Core', 'Gui', 'Widgets', 'Network', 'Svg'])
drm_dep = dependency('libdrm')
pam_dep = dependency('pam')

hwdata_dep = dependency('hwdata', required: false)
if hwdata_dep.found()
  add_project_arguments(
    '-DHWDATA_DIR="' + hwdata_dep.get_variable(pkgconfig: 'pkgdatadir') + '"',
    language: 'cpp',
  )
endif

sources = files(
  'main.cpp',
  'mainwindow.cpp',
  'monitorwidget.cpp',
  'page_sysinfo.cpp',
  'sysinfo/battery.cpp',
  'sysinfo/collect.cpp',
  'sysinfo/network.cpp',
  'sysinfo/pciids.cpp',
  'sysinfo/storage.cpp',
  'page_upgrade.cpp',
  'upgrade/changelog.cpp',
  'upgrade/panel.cpp',
  'upgrade/run.cpp',
  'upgrade/scan.cpp',
  'page_usersettings.cpp',
  'ui/lockpage.cpp',
  'users/accounts.cpp',
  'users/nixfiles.cpp',
  'users/ops.cpp',
  'users/panel.cpp',
  'page_monitors.cpp',
  'page_applications.cpp',
  'apps/flake.cpp',
  'apps/password.cpp',
  'apps/pkgindex.cpp',
  'apps/pkglist.cpp',
  'apps/unstable.cpp',
  'apps/icons.cpp',
  'apps/iconfarm.cpp',
  'apps/rowdelegate.cpp',
  'page_mousekeyboard.cpp',
  'input/devices.cpp',
  'input/kbdmesh.cpp',
  'input/kbdpanel.cpp',
  'input/mesh.cpp',
  'input/module.cpp',
  'input/mousemesh.cpp',
  'input/mousepanel.cpp',
  'input/settings.cpp',
  'input/view3d.cpp',
  'page_shortcuts.cpp',
  'page_statusbar.cpp',
  'page_neovim.cpp',
  'page_storage.cpp',
  'page_firewall.cpp',
  'page_git.cpp',
  'git/auth.cpp',
  'git/keys.cpp',
  'git/lockout.cpp',
  'git/module.cpp',
  'git/panel.cpp',
  'git/rebuild.cpp',
  'git/repo.cpp',
  'git/services.cpp',
  'git/style.cpp',
  'git/task.cpp',
  'page_backup.cpp',
  'page_gaming.cpp',
  'page_winvm.cpp',
  'page_cleanup.cpp',
)

executable('nixlycc',
  sources,
  dependencies: [qt6_dep, drm_dep, pam_dep],
  install: true,
)
